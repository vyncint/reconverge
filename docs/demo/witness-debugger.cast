[0.0037, "o", "\u001b[1;1H\u250c\u001b[1m reconverge witness \u001b[22m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[2;1H\u2502\u001b[1mwitness 1/2 \u2014 kernel `rc001_divergent_barrier` \u2014 RC001 \u2014 grid (1,1,1) block (\u2026\u001b[22m\u2502\u001b[3;1H\u2502\u001b[3;80H\u2502\u001b[4;1H\u2502\u001b[2m          0        8        16       24\u001b[4;80H\u001b[22m\u2502\u001b[5;1H\u2502lanes\u001b[5;12H\u001b[38;5;2;49moooooooo\u001b[5;21Hoooooooo\u001b[5;30Hoooooooo\u001b[5;39Hoooooooo\u001b[5;80H\u001b[39;49m\u2502\u001b[6;1H\u2502\u001b[2mmask      (not at a warp collective)\u001b[6;80H\u001b[22m\u2502\u001b[7;1H\u2502\u001b[7;80H\u2502\u001b[8;1H\u2502\u001b[2m          o active   W waiting   . exited\u001b[8;80H\u001b[22m\u2502\u001b[9;1H\u2502\u001b[9;80H\u2502\u001b[10;1H\u2502\u001b[38;5;6;49mstep 0/3  [...]\u001b[10;80H\u001b[39;49m\u2502\u001b[11;1H\u2502launch\u001b[11;9H\u2014\u001b[11;11Hbefore\u001b[11;18Hthe\u001b[11;22Hfirst\u001b[11;28Hevent\u001b[11;80H\u2502\u001b[12;1H\u2502\u001b[12;80H\u2502\u001b[13;1H\u2502\u001b[13;80H\u2502\u001b[14;1H\u2502\u001b[14;80H\u2502\u001b[15;1H\u2502\u001b[1m\u001b[38;5;6;49m\u25b8  0  launch\u001b[15;80H\u001b[22m\u001b[39;49m\u2502\u001b[16;1H\u2502\u001b[2m   1  lanes evaluate the guarding branch \u2014 16 continue"]
[0.0038, "o", " toward `sync_threads`,\u2026\u001b[22m\u2502\u001b[17;1H\u2502\u001b[2m   2  sync_threads() \u2014 16 of 32 lanes arrive and wait             16 waiting\u001b[17;80H\u001b[22m\u2502\u001b[18;1H\u2502\u001b[2m   3  the other 16 lanes exit or move past reconvergence without ever reachin\u2026\u001b[22m\u2502\u001b[19;1H\u2502\u001b[19;80H\u2502\u001b[20;1H\u2502\u001b[2mverdict: undefined behavior (at step 3)\u001b[20;80H\u001b[22m\u2502\u001b[21;1H\u2502\u001b[21;80H\u2502\u001b[22;1H\u2502\u001b[22;80H\u2502\u001b[23;1H\u2502\u001b[23;80H\u2502\u001b[24;1H\u2514\u001b[2m h/l step  g/G ends  d split  v verdict  n/N witness  q quit \u001b[22m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l\u001b[?2026l"]
